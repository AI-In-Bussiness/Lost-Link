{
  "name": "lostlink",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:start": "node scripts/start-database.mjs",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "node scripts/test-database.mjs",
    "demo:accounts": "node scripts/provision-demo.mjs",
    "env:local": "node scripts/configure-local.mjs",
    "test:integration": "node scripts/smoke-auth.mjs",
    "test:live": "node scripts/test-live.mjs",
    "test:backend": "node scripts/smoke-backend.mjs",
    "test:mocks": "node --experimental-strip-types --test src/mocks/client.test.ts",
    "env:photos": "node scripts/configure-photo-worker.mjs",
    "test:photos": "node scripts/smoke-photos.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "eval:search": "tsx scripts/evaluate-search-offline.ts",
    "model:download": "node --use-env-proxy scripts/download-search-model.mjs",
    "eval:search:live": "tsx --env-file=.env.local scripts/evaluate-search.ts",
    "prebuild": "npm run model:download",
    "check:search:bundle": "node scripts/check-search-bundle.mjs",
    "test:search:model": "tsx --test tests/local-model.integration.ts",
    "demo:check": "node scripts/verify-demo.mjs",
    "test:demo": "node scripts/test-demo-repeatability.mjs",
    "release:check": "node --use-env-proxy scripts/release-smoke.mjs",
    "test:release": "node --test tests/release-smoke.test.mjs tests/auth-redirects.test.mjs",
    "auth:check": "node --use-env-proxy scripts/auth-redirects.mjs check",
    "auth:configure": "node --use-env-proxy scripts/auth-redirects.mjs configure"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "supabase": "2.75.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "overrides": {
    "tar": "7.5.22"
  }
}
