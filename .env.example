# Public project settings: use local `supabase status` or your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public settings accept only a publishable or legacy anon key, never a secret/service-role key.
# Remote Supabase URLs require HTTPS; session cookies are HttpOnly and Secure on HTTPS.
# Exact origin used for same-origin auth mutations. Set to deployed HTTPS origin on Vercel.
# Also configure hosted Supabase Site URL and callback redirects; see docs/coordination/auth-email-redirects.md.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Trusted server photo processor, deleted-school photo cleanup and operator provisioning.
# Required for uploads and permanent photo cleanup; ordinary data APIs and photo reads do not use it. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Local/demo operator chooses a unique password; do not commit a value.
LOSTLINK_DEMO_PASSWORD=

# Optional public school-selector slugs, resolved through the API.
LOSTLINK_ORGANIZATION_SLUGS=maple-school,cedar-school

# Free local CPU matching is enabled when the pinned model files are installed.
# Run npm run model:download during setup. No inference API/key is used.
# Set false to force keyword-only search.
LOSTLINK_SEMANTIC_SEARCH=true
