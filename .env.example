# Public project settings: use local `supabase status` or your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact origin used for same-origin auth mutations. Set to deployed HTTPS origin on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Trusted server photo processor and operator provisioning only.
# Required for uploads; ordinary data APIs and photo reads do not use it. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Local/demo operator chooses a unique password; do not commit a value.
LOSTLINK_DEMO_PASSWORD=
